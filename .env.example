# PadCare Environment & API Configuration Example
# Copy this file to .env or pass these as environment/build variables

# Translation API Endpoint (Supplied Go server)
# For local Android emulator: http://10.0.2.2:8000
# For local Web/Desktop/iOS Simulator: http://localhost:8000
# For production: https://api.padcare.org or deployed translation service
TRANSLATION_API_URL=http://localhost:8000

# Free Realtime Backend & Auth (Supabase)
# Get a 100% free project at https://supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google Gemini AI Assistant (HerHelp)
# Get a free API key at https://aistudio.google.com
GEMINI_API_KEY=AIzaSy...

# Google Maps API Key (Optional; OpenStreetMap is enabled out-of-the-box for free)
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Backend Mode: mock (offline-first simulated storage) or live (Supabase Realtime)
APP_ENVIRONMENT=production
ENABLE_ANALYTICS=false
OFFLINE_MESH_PORT=8848
