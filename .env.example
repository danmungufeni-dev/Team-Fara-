# PadCare Environment & API Configuration Example
# Copy this file to .env or pass these as environment/build variables

# Translation API Endpoint (Supplied Go server)
# For local Android emulator: http://10.0.2.2:8000
# For local Web/Desktop/iOS Simulator: http://localhost:8000
# For production: https://api.padcare.org or deployed translation service
TRANSLATION_API_URL=http://localhost:8000

# Google Maps API Key
# Replace with your actual Google Maps SDK key
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Backend Mode: mock (offline-first simulated storage) or live (REST/Firebase)
APP_ENVIRONMENT=production
ENABLE_ANALYTICS=false
OFFLINE_MESH_PORT=8848
